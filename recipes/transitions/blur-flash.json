{
  "id": "blur-flash",
  "name": "Blur flash",
  "lengthFrames": 8,
  "notes": "Blur peaking on the cut with a soft flash.",
  "layers": [
    {
      "type": "solid",
      "name": "Flash",
      "color": [1, 1, 1],
      "blendMode": "ADD",
      "transform": {
        "ADBE Opacity": { "keys": [[0, 0, "linear"], [0.5, 60, "linear"], [1, 0, "smooth"]], "rest": 0 }
      }
    },
    {
      "type": "adjustment",
      "name": "Blur",
      "effects": [
        {
          "matchName": "ADBE Gaussian Blur 2",
          "params": {
            "1": { "keys": [[0, 0, "smooth"], [0.5, 45, "linear"], [1, 0, "smooth"]], "rest": 0 },
            "3": 1
          }
        }
      ]
    }
  ]
}
